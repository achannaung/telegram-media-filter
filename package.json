{
  "name": "telegram-media-filter",
  "version": "1.0.0",
  "private": true,
  "description": "Web app to get direct media links from public Telegram posts within an inclusive date range",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.js\" \"vite\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.2"
  }
}
